# Postgres connection
DATABASE_URL=postgres://darroo:darroo@localhost:5432/darroo

# OpenAI
OPENAI_API_KEY=
OPENAI_FILTER_MODEL=gpt-4o-mini
OPENAI_WRITER_MODEL=gpt-4o

# Internal web server (posting list + intake forms)
PORT=3000
# Shared secret required to open /internal/* pages
INTERNAL_ACCESS_TOKEN=change-me

# Optional: free Telegram bot used to report pipeline errors instead of
# letting a run fail silently. Leave empty to only log errors to the DB/console.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public base URL used in generated post texts (darroo.com link, UTM, etc.)
PUBLIC_SITE_URL=https://darroo.com
